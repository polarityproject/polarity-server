# The rooms stack's settings: copy to .env in this folder (compose reads it).
# The TCP port the mod connects to (the rooms build's server address).
SFVR_PORT=5555
# UDP ports for the keeper's peer-to-peer links (open them in ufw). A range
# with a dash, as polarity-keeper's --ports takes it.
KEEPER_PORTS=47200-47299
# The desync and crash reports' TCP port (open it in ufw) and their limits:
# the reports folder and the crashes folder in MB (the oldest are removed
# past them), and files an hour from one address.
REPORTS_PORT=5580
REPORTS_MAX_MB=4096
CRASHES_MAX_MB=1024
REPORTS_PER_HOUR=120

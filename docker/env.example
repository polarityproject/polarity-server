# The rooms stack's settings: copy to .env in this folder (compose reads it).
# The TCP port the mod connects to (the rooms build's server address).
SFVR_PORT=5555
# UDP ports for the keeper's peer-to-peer links (open them in ufw). A range
# with a dash, as sfvr-keeper's --ports takes it.
KEEPER_PORTS=47200-47299

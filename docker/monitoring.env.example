# The monitoring stack's settings (compose.monitoring.yaml): copy to
# monitoring.env in this folder.
#
# The rooms API Worker's address (cloudflare/rooms-api, `wrangler deploy`
# prints it), without a path. Empty: the publisher stays idle.
ROOMS_API_URL=
# How often the publisher looks at the keeper's list (seconds), and the
# longest it goes without a push while nothing changes.
PUBLISH_EVERY=10
PUBLISH_HEARTBEAT=60

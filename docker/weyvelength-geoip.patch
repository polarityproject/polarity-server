diff --git a/Server/include/geoip.h b/Server/include/geoip.h
new file mode 100644
index 0000000..0ed8ee2
--- /dev/null
+++ b/Server/include/geoip.h
@@ -0,0 +1,44 @@
+#pragma once
+
+// The country of a client's address, from an IP-to-country database in the
+// MaxMind DB format (DB-IP's free "IP to Country Lite", or GeoLite2 Country):
+// the server's own lookup, so a client cannot claim another country. Built
+// with libmaxminddb when it is found (WEYVELENGTH_GEOIP); without it, or
+// without a file, every lookup is "".
+
+#include <chrono>
+#include <filesystem>
+#include <string>
+
+#include <asio.hpp>
+
+struct MMDB_s;
+
+namespace Weyvelength {
+
+	class GeoIp {
+	public:
+		GeoIp() = default;
+		GeoIp(const GeoIp&) = delete;
+		GeoIp& operator=(const GeoIp&) = delete;
+		~GeoIp();
+
+		// The database file, reopened when it changes (checked at most once a
+		// minute). For loopback and private addresses, `private_country` (for
+		// testing a server on a LAN; empty: none).
+		void Configure(std::string path, std::string private_country);
+
+		// "DE" (ISO 3166-1 alpha-2), or "" when unknown.
+		std::string Country(const asio::ip::address& address);
+
+	private:
+		void Reopen();
+
+		std::string _path;
+		std::string _private;
+		MMDB_s* _db = nullptr;
+		std::filesystem::file_time_type _opened{};
+		std::chrono::steady_clock::time_point _checked{};
+		bool _said_missing = false;
+	};
+}

+	{
+		if (conn->country.empty() || conn->hide_country)
+			return;
+		room.member_data[conn->id][server_country_key] = conn->country;
+		SendToMany(room.members, Proto::MemberDataChanged{ conn->id, server_country_key, conn->country });

diff --git a/Server/src/geoip.cpp b/Server/src/geoip.cpp
new file mode 100644
index 0000000..733ade5
--- /dev/null
+++ b/Server/src/geoip.cpp
@@ -0,0 +1,120 @@
+#include "geoip.h"
+
+#include <cctype>
+
+#include <spdlog/spdlog.h>
+
+#ifdef WEYVELENGTH_GEOIP
+#include <maxminddb.h>
+#endif
+
+namespace Weyvelength {
+
+	static bool IsPrivate(const asio::ip::address& address)
+	{
+		if (address.is_loopback() || address.is_unspecified())
+			return true;
+		if (address.is_v4()) {
+			const auto b = address.to_v4().to_bytes();
+			return b[0] == 10 || (b[0] == 172 && (b[1] & 0xF0) == 16) || (b[0] == 192 && b[1] == 168) ||
+				(b[0] == 169 && b[1] == 254) || (b[0] == 100 && (b[1] & 0xC0) == 64); // RFC 1918, link-local, CGNAT
+		}
+		const auto v6 = address.to_v6();
+		if (v6.is_v4_mapped())
+			return IsPrivate(asio::ip::make_address_v4(asio::ip::v4_mapped, v6));
+		const auto b = v6.to_bytes();
+		return v6.is_link_local() || (b[0] & 0xFE) == 0xFC; // fe80::/10, fc00::/7
+	}
+
+	static std::string TwoLetters(const char* text, size_t length)
+	{
+		if (length != 2 || !std::isalpha((unsigned char)text[0]) || !std::isalpha((unsigned char)text[1]))
+			return {};
+		return { (char)std::toupper((unsigned char)text[0]), (char)std::toupper((unsigned char)text[1]) };
+	}
+
+	GeoIp::~GeoIp()
+	{
+#ifdef WEYVELENGTH_GEOIP
+		if (_db) {
+			MMDB_close(_db);
+			delete _db;
+		}
+#endif
+	}
+
+	void GeoIp::Configure(std::string path, std::string private_country)
+	{
+		_path = std::move(path);
+		_private = TwoLetters(private_country.c_str(), private_country.size());
+#ifndef WEYVELENGTH_GEOIP
+		if (!_path.empty())
+			spdlog::warn("GeoIp: built without libmaxminddb; {} is not read, no countries", _path);
+#endif
+		Reopen();
+	}
+
+	void GeoIp::Reopen()
+	{
+#ifdef WEYVELENGTH_GEOIP
+		if (_path.empty())
+			return;
+		std::error_code ec;
+		const auto written = std::filesystem::last_write_time(_path, ec);
+		if (ec) {
+			if (!_db && !_said_missing)
+				spdlog::warn("GeoIp: no database at {} yet; no countries until it is there", _path);
+			_said_missing = true;
+			return;
+		}
+		if (_db && written == _opened)
+			return;
+		auto* db = new MMDB_s{};
+		const int status = MMDB_open(_path.c_str(), MMDB_MODE_MMAP, db);
+		if (status != MMDB_SUCCESS) {
+			spdlog::warn("GeoIp: cannot open {}: {}", _path, MMDB_strerror(status));
+			delete db;
+			return;
+		}
+		if (_db) {
+			MMDB_close(_db);
+			delete _db;
+		}
+		_db = db;
+		_opened = written;
+		spdlog::info("GeoIp: {} ({}, built {})", _path, db->metadata.database_type ? db->metadata.database_type : "?",
+			(long long)db->metadata.build_epoch);
+#endif
+	}
+
+	std::string GeoIp::Country(const asio::ip::address& address)
+	{
+#ifdef WEYVELENGTH_GEOIP
+		const auto now = std::chrono::steady_clock::now();
+		if (now - _checked > std::chrono::minutes(1)) {
+			_checked = now;
+			Reopen(); // a new month's file, or the first one
+		}
+#endif
+		if (IsPrivate(address))
+			return _private;
+#ifdef WEYVELENGTH_GEOIP
+		if (!_db)
+			return {};
+		const std::string text = address.is_v6() && address.to_v6().is_v4_mapped()
+			? asio::ip::make_address_v4(asio::ip::v4_mapped, address.to_v6()).to_string()
+			: address.to_string();
+		int gai_error = 0, mmdb_error = MMDB_SUCCESS;
+		MMDB_lookup_result_s result = MMDB_lookup_string(_db, text.c_str(), &gai_error, &mmdb_error);
+		if (gai_error != 0 || mmdb_error != MMDB_SUCCESS || !result.found_entry)
+			return {};
+		MMDB_entry_data_s data{};
+		if (MMDB_get_value(&result.entry, &data, "country", "iso_code", nullptr) != MMDB_SUCCESS || !data.has_data ||
+			data.type != MMDB_DATA_TYPE_UTF8_STRING)
+			return {};
+		return TwoLetters(data.utf8_string, data.data_size);
+#else
+		return {};
+#endif
+	}
+}

{
  "uid": "sfvr-rooms-vps",
  "title": "Polarity rooms VPS",
  "description": "The VPS's health (node_exporter) and each container (container-stats).",
  "tags": [
    "polarity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"

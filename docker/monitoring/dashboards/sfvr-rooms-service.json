    {
      "id": 10,
      "type": "row",
      "title": "The keeper's loop (one thread: when it falls behind, every answer waits)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []

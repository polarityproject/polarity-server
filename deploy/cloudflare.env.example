# Cloudflare Realtime TURN key: in the Cloudflare dashboard under Realtime,
# create a TURN key (https://developers.cloudflare.com/realtime/turn/).
# Installed as /etc/sfvr-server/cloudflare.env, mode 0600: keep it that way,
# the token can mint relay credentials billed to the account.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# How long each batch of credentials lasts (seconds); the timer renews every 6 h.
CF_TURN_TTL=86400
# UDP ports to hand out: 3478, and 53, which passes many networks that block
# 3478. libjuice only speaks TURN over UDP, so the TCP/TLS ones are left out.
CF_TURN_PORTS="3478 53"

# sfvr-server: the Weyvelength rooms server for Polarity
# (docs/server-vps.md). Rooms live in memory; matches run peer to peer, or
# through Cloudflare's TURN relay with the credentials in the ice file.
[Unit]
Description=sfvr-server, rooms for Polarity (Weyvelength)
After=network-online.target sfvr-server-ice.service
Wants=network-online.target

[Service]
User=sfvr-server
Group=sfvr-server
StateDirectory=sfvr-server
# SFVR_PORT, 5555 unless changed there.
Environment=SFVR_PORT=5555
EnvironmentFile=-/etc/sfvr-server/server.env
# 6-character room codes: the mod's match codes.
ExecStart=/opt/sfvr-server/bin/weyvelength-server --port ${SFVR_PORT} --room-code-length 6 --ice-file /var/lib/sfvr-server/ice.conf
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

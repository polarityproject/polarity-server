# sfvr-reports: takes the desync and crash reports SFVR games send, under
# /var/lib/sfvr-server/reports and crashes (docs/server-vps.md, "Desync and
# crash reports").
[Unit]
Description=sfvr-server, desync and crash reports from SFVR games
After=network-online.target
Wants=network-online.target

[Service]
User=sfvr-server
Group=sfvr-server
StateDirectory=sfvr-server
# SFVR_REPORTS_PORT (5580), SFVR_REPORTS_MAX_MB (4096) and SFVR_CRASHES_MAX_MB
# (1024) unless changed there.
Environment=SFVR_REPORTS_PORT=5580 SFVR_REPORTS_MAX_MB=4096 SFVR_CRASHES_MAX_MB=1024
EnvironmentFile=-/etc/sfvr-server/server.env
ExecStart=/usr/bin/python3 /opt/sfvr-server/bin/sfvr-reports.py --dir /var/lib/sfvr-server/reports --crashes-dir /var/lib/sfvr-server/crashes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sfvr-server/reports /var/lib/sfvr-server/crashes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target

# sfvr-server's settings, installed as /etc/sfvr-server/server.env.
# The TCP port the mod connects to ("[weyve] server=host:port"). Change it if
# another server on the machine already uses 5555, then:
#   sudo systemctl restart sfvr-server
SFVR_PORT=5555

# Desync reports (sfvr-reports.service): the TCP port SFVR games send them to
# ("[report] url" in the mod: http://<server>:<port>), and how much disk they
# may take before the oldest matches are removed.
SFVR_REPORTS_PORT=5580
SFVR_REPORTS_MAX_MB=4096

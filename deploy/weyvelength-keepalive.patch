+	// A client whose network goes away without closing the connection (a
+	// phone hotspot or a carrier NAT taking a new address, a cable pulled)
+	// sends nothing more, and nothing here waits on it: it stayed a member of
+	// its room until a write to it failed after Linux's retransmissions (about
+	// 15 minutes), or for good when nothing was written. TCP keepalive asks its
+	// end after 30 quiet seconds, then every 10 s; TCP_USER_TIMEOUT ends the
+	// connection when 45 s pass without an answer, to a probe or to data. A
+	// live client's own TCP answers the probes, whatever its version: no
+	// client changes.
+	static constexpr int keepalive_idle_s = 30;
+	static constexpr int keepalive_interval_s = 10;
+	static constexpr int keepalive_count = 3;
+	static constexpr unsigned keepalive_unanswered_ms = 45000;
+
+	static void KeepAlive(asio::ip::tcp::socket& socket, uint32_t id)
+	{
+		asio::error_code ec;
+		socket.set_option(asio::socket_base::keep_alive(true), ec);
+#if defined(TCP_KEEPIDLE)
+		if (!ec) socket.set_option(asio::detail::socket_option::integer<IPPROTO_TCP, TCP_KEEPIDLE>(keepalive_idle_s), ec);
+#endif
+#if defined(TCP_KEEPINTVL)
+		if (!ec) socket.set_option(asio::detail::socket_option::integer<IPPROTO_TCP, TCP_KEEPINTVL>(keepalive_interval_s), ec);
+#endif
+#if defined(TCP_KEEPCNT)
+		if (!ec) socket.set_option(asio::detail::socket_option::integer<IPPROTO_TCP, TCP_KEEPCNT>(keepalive_count), ec);
+#endif
+#if defined(TCP_USER_TIMEOUT)
+		if (!ec) socket.set_option(asio::detail::socket_option::integer<IPPROTO_TCP, TCP_USER_TIMEOUT>(keepalive_unanswered_ms), ec);
+#endif
+		if (ec)
+			spdlog::warn("Client {}: cannot turn on keepalive: {}", id, ec.message());
+	}
+
 	asio::awaitable<void> Server::Session(std::shared_ptr<Connection> conn)
 	{
+		KeepAlive(conn->socket, conn->id);
 		asio::co_spawn(conn->socket.get_executor(), WriteLoop(conn), asio::detached);
 
 		SendTo(conn->id, Proto::AssignClientId{ conn->id, conn->name });
@@ -194,6 +229,10 @@ namespace Weyvelength {

diff --git a/Shared/framing.h b/Shared/framing.h
index bc6712f..b89c665 100644
--- a/Shared/framing.h
+++ b/Shared/framing.h
@@ -21,6 +21,14 @@ namespace Weyvelength::Proto {
 	constexpr size_t frame_header_size = sizeof(uint32_t);
 	constexpr uint32_t frame_more_flag = 0x80000000u; // header high bit: another fragment follows
 	constexpr size_t max_reassembled_size = 64 * max_message_size; // cap on one reassembled message; sized for the room list
+	// Cap on what decoding one message may allocate for any one string or
+	// list. zpp_bits sizes a container from the count in the message before
+	// it checks the bytes are there, so without it a 9-byte message claiming
+	// gigabytes makes the reader allocate them. Generous for anything a real
+	// message of max_reassembled_size holds (a room list's entries take far
+	// more memory than wire bytes).
+	constexpr size_t max_decode_allocation = 64 * max_reassembled_size;
+	using DecodeLimit = zpp::bits::alloc_limit<max_decode_allocation>;
 
 	// Encodes a message as one or more length-prefixed fragments, each within
 	// max_message_size, ready to write to a socket back to back.

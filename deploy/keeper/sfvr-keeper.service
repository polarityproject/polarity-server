# polarity-keeper: hosts Polarity's lobby channel and custom rooms on the rooms
# server running beside it (sfvr-server.service), as a client of it. Its
# P2P links (private answers to players) bind UDP 47200-47299, which
# install-keeper.sh opens in ufw.
[Unit]
Description=polarity-keeper, custom rooms for Polarity
After=network-online.target sfvr-server.service
Wants=network-online.target sfvr-server.service

[Service]
User=sfvr-server
Group=sfvr-server
StateDirectory=sfvr-server/keeper
# SFVR_PORT, 5555 unless changed there (the rooms server's port).
Environment=SFVR_PORT=5555
EnvironmentFile=-/etc/sfvr-server/server.env
ExecStart=/opt/sfvr-server/bin/sfvr-keeper --key /etc/sfvr-server/keeper.key --state /var/lib/sfvr-server/keeper/state --words /etc/sfvr-server/keeper-words.txt --server 127.0.0.1:${SFVR_PORT} --ports 47200-47299
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
